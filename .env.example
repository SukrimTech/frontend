# Sukrim frontend — build-time settings.
#
# Local development needs NONE of these: `npm run dev` proxies /api to the servers on this
# machine (see vite.config.js). On Vercel, add them under Project → Settings → Environment
# Variables (Production and Preview), then redeploy — Vite bakes them in at BUILD time.
# Every VITE_* value ends up in the public JavaScript bundle: nothing here may be a secret.

# The backend's public https address: the Cloudflare tunnel in front of the gateway on the
# lab machine (Sukrim/deploy/PUBLIC_URL shows the current one). No trailing slash.
VITE_API_BASE=https://api.your-domain.example

# Must equal ACCESS_TOKEN in Sukrim/deploy/.env when the gateway has one; empty otherwise.
# Visible to anyone who opens the page — it keeps scanners out, it is not authentication.
VITE_ACCESS_TOKEN=

# MapTiler key for the map tiles (cloud.maptiler.com → Account → API keys). Without one the
# maps fall back to Esri's keyless tiles. Restrict the key to your Vercel domain there.
VITE_MAPTILER_KEY=

# Only for `npm run dev` / local builds: where the Sukrim repository's docs/ folder is, if
# not at ../Sukrim/docs. On Vercel the /docs page is empty unless the docs are reachable.
# SUKRIM_DOCS=../Sukrim/docs
